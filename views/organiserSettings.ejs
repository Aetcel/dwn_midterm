<!DOCTYPE html>
<html>
<head><title>Organiser Settings</title></head>
<body>
<h1>Site Settings Page</h1>
<form action="/organiser/settings" method="POST">
    <label for="siteName">Site Name</label>
    <input type="text" name="siteName" id="siteName" value="<%= siteSettings.siteName %>" required />

    <label for="siteDescription">Site Description</label>
    <input type="text" name="siteDescription" id="siteDescription" value="<%= siteSettings.siteDescription %>" required />

    <button type="submit">Save</button>
</form>

<a href="/organiser">Back</a>
</body>
</html>
