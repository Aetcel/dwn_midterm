<!DOCTYPE html>
<html>
<head>
    <title>Edit Event</title>
    <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
</head>
<body class="m-4">
<h1>Organiser Edit Event Page</h1>
<% if (event) { %>
    <p>Created at: <%= event.created_at %></p>
    <form action="/organiser/edit/<%= event.id %>" method="POST">
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input
                    type="text"
                    name="title"
                    value="<%= event.title %>"
                    class="form-control"
                    required
            />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea
                    name="description"
                    class="form-control"
                    required
            ><%= event.description %></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Full Price Tickets (count)</label>
            <input
                    type="number"
                    name="full_price_count"
                    value="<%= event.full_price_count %>"
                    class="form-control"
            />
        </div>

        <div class="mb-3">
            <label class="form-label">Full Price Tickets (price)</label>
            <input
                    type="number"
                    step="0.01"
                    name="full_price_price"
                    value="<%= event.full_price_price %>"
                    class="form-control"
            />
        </div>

        <div class="mb-3">
            <label class="form-label">Concession Tickets (count)</label>
            <input
                    type="number"
                    name="concession_count"
                    value="<%= event.concession_count %>"
                    class="form-control"
            />
        </div>

        <div class="mb-3">
            <label class="form-label">Concession Tickets (price)</label>
            <input
                    type="number"
                    step="0.01"
                    name="concession_price"
                    value="<%= event.concession_price %>"
                    class="form-control"
            />
        </div>

        <div class="mb-3">
            <label class="form-label">Event Date</label>
            <input
                    type="date"
                    name="event_date"
                    value="<%= event.event_date ? event.event_date.split('T')[0] : '' %>"
                    class="form-control"
            />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
    </form>
<% } else { %>
    <p>Event not found.</p>
<% } %>

<p class="mt-3">
    <a href="/organiser" class="btn btn-link">Back</a>
</p>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
