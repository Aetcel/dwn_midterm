<!DOCTYPE html>
<html>
<head>
    <title>Organiser Home</title>
    <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
</head>
<body class="m-4">
<h1>Organiser Home Page</h1>

<% if (siteSettings) { %>
    <h2><%= siteSettings.siteName %></h2>
    <p><%= siteSettings.siteDescription %></p>
<% } %>

<nav class="my-3">
    <a class="btn btn-link" href="/organiser/settings">Site Settings</a>
    <form action="/organiser/create" method="POST" class="d-inline">
        <button type="submit" class="btn btn-primary">Create New Event</button>
    </form>
</nav>

<h3>Published Events</h3>
<ul class="list-group mb-4">
    <% publishedEvents.forEach(ev => { %>
        <li class="list-group-item">
            <strong>Title:</strong> <%= ev.title %><br/>
            <strong>Date:</strong> <%= ev.event_date %><br/>
            <strong>Published at:</strong> <%= ev.published_at %> <br/>
            <a href="/attendee/event/<%= ev.id %>" class="btn btn-sm btn-link">Attendee Link</a>
            <form action="/organiser/delete/<%= ev.id %>" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
        </li>
    <% }) %>
</ul>

<h3>Draft Events</h3>
<ul class="list-group">
    <% draftEvents.forEach(ev => { %>
        <li class="list-group-item">
            <strong>Title:</strong> <%= ev.title %><br/>
            <strong>Date:</strong> <%= ev.event_date %><br/>
            <a href="/organiser/edit/<%= ev.id %>" class="btn btn-sm btn-info">Edit</a>
            <form action="/organiser/publish/<%= ev.id %>" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-success">Publish</button>
            </form>
            <form action="/organiser/delete/<%= ev.id %>" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
        </li>
    <% }) %>
</ul>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
