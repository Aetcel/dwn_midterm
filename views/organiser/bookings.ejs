<!DOCTYPE html>
<html>
<head>
    <title>All Bookings</title>
    <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
</head>
<body class="m-4">
<h1>All Bookings</h1>
<table class="table table-bordered">
    <thead>
    <tr>
        <th>Booking ID</th>
        <th>Event Title</th>
        <th>Event Date</th>
        <th>Attendee Name</th>
        <th>Full Price Booked</th>
        <th>Concession Booked</th>
        <th>Booked At</th>
    </tr>
    </thead>
    <tbody>
    <% bookings.forEach(b => { %>
        <tr>
            <td><%= b.booking_id %></td>
            <td><%= b.event_title %></td>
            <td><%= b.event_date %></td>
            <td><%= b.attendee_name %></td>
            <td><%= b.full_price_booked %></td>
            <td><%= b.concession_booked %></td>
            <td><%= b.booked_at %></td>
        </tr>
    <% }) %>
    </tbody>
</table>
<p><a href="/organiser" class="btn btn-link">Back</a></p>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
