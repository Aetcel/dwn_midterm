<!DOCTYPE html>
<html>
<head>
    <title>Organiser Settings</title>
</head>
<body>
<h1>Site Settings</h1>
<% if (siteSettings) { %>
    <form action="/organiser/settings" method="POST">
        <label>Site Name:</label>
        <input type="text" name="siteName" value="<%= siteSettings.siteName %>" required /><br/>

        <label>Site Description:</label>
        <input type="text" name="siteDescription" value="<%= siteSettings.siteDescription %>" required /><br/>

        <button type="submit">Save</button>
    </form>
<% } else { %>
    <p>No site settings found!</p>
<% } %>
<a href="/organiser">Back</a>
</body>
</html>
