<!DOCTYPE html>
<html>
<head>
    <title>Attendee Event Page</title>
    <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
</head>
<body class="m-4">
<h1>Attendee Event Page</h1>
<% if (event) { %>
    <h2><%= event.title %></h2>
    <p><%= event.description %></p>
    <p>Date: <%= event.event_date %></p>
    <p>
        Full Price Tickets Available: <%= event.full_price_count %>
        (Price: <%= event.full_price_price %>)
    </p>
    <p>
        Concession Tickets Available: <%= event.concession_count %>
        (Price: <%= event.concession_price %>)
    </p>

    <form action="/attendee/event/<%= event.id %>/book" method="POST">
        <div class="mb-3">
            <label class="form-label">Your Name</label>
            <input
                    type="text"
                    name="attendee_name"
                    class="form-control"
                    placeholder="Enter your name"
                    required
            />
        </div>
        <div class="mb-3">
            <label class="form-label">
                Full Price Tickets (max <%= event.full_price_count %>)
            </label>
            <input
                    type="number"
                    name="full_price_count"
                    class="form-control"
                    min="0"
                    max="<%= event.full_price_count %>"
            />
        </div>
        <div class="mb-3">
            <label class="form-label">
                Concession Tickets (max <%= event.concession_count %>)
            </label>
            <input
                    type="number"
                    name="concession_count"
                    class="form-control"
                    min="0"
                    max="<%= event.concession_count %>"
            />
        </div>
        <button type="submit" class="btn btn-primary">Book</button>
    </form>
<% } else { %>
    <p>Event not found or not published.</p>
<% } %>

<p class="mt-3">
    <a href="/attendee" class="btn btn-link">Back</a>
</p>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
