<!DOCTYPE html>
<html>
<head>
    <title>Attendee Home</title>
    <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    />
</head>
<body class="m-4">
<h1>Attendee Home Page</h1>
<% if (siteSettings) { %>
    <h2><%= siteSettings.siteName %></h2>
    <p><%= siteSettings.siteDescription %></p>
<% } %>

<ul class="list-group">
    <% publishedEvents.forEach(e => { %>
        <li class="list-group-item">
            <a href="/attendee/event/<%= e.id %>">
                <strong><%= e.title %></strong> - <%= e.event_date %>
            </a>
        </li>
    <% }) %>
</ul>

<p class="mt-3">
    <a href="/" class="btn btn-link">Back to Main</a>
</p>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
