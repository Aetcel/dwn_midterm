<!DOCTYPE html>
<html>
<head><title>Edit Event</title></head>
<body>
<h1>Organiser Edit Event Page</h1>
<p>Event created at: <%= event.created_at %></p>

<form action="/organiser/edit/<%= event.id %>" method="POST">
    <label>Title</label>
    <input type="text" name="title" value="<%= event.title %>" required />

    <label>Description</label>
    <textarea name="description" required><%= event.description %></textarea>

    <label>Full Price Tickets (Count)</label>
    <input type="number" name="full_price_tix_count" value="<%= event.full_price_tix_count %>" />

    <label>Full Price Tickets (Price)</label>
    <input type="number" step="0.01" name="full_price_tix_price" value="<%= event.full_price_tix_price %>" />

    <label>Concession Tickets (Count)</label>
    <input type="number" name="concession_tix_count" value="<%= event.concession_tix_count %>" />

    <label>Concession Tickets (Price)</label>
    <input type="number" step="0.01" name="concession_tix_price" value="<%= event.concession_tix_price %>" />

    <label>Event Date</label>
    <input type="date" name="event_date" value="<%= event.event_date ? event.event_date.split('T')[0] : '' %>" />

    <button type="submit">Save Changes</button>
</form>

<a href="/organiser">Back</a>
</body>
</html>
